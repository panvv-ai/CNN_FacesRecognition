{
  "name": "face-workbench-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "api:types": "openapi-typescript ../openapi.json -o src/api/schema.ts"
  },
  "dependencies": {
